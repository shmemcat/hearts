# Local development only. Copy to .env and keep real credentials out of Git.
POSTGRES_USER=hearts
POSTGRES_PASSWORD=hearts
POSTGRES_DB=hearts
JWT_SECRET=replace-with-a-long-random-local-secret
CORS_ORIGINS=http://localhost:3001
FRONTEND_URL=http://localhost:3001

# Shared hub origin enables the cookie API. Keep blank for legacy production.
CARDS_PUBLIC_URL=
# Production builds only. Set true when deploying with shared Cards accounts.
VITE_SHARED_ACCOUNTS=
VITE_BASE_PATH=/
# Keep 0 for direct dev access. Set the exact trusted proxy count in production.
TRUSTED_PROXY_HOPS=0
# The monthly administration endpoint is disabled when this is blank.
ADMIN_KEY=

# Required to install the private Font Awesome Pro npm packages.
FONTAWESOME_PACKAGE_TOKEN=

# Optional: required only for verification and password-reset email delivery.
SMTP2GO_API_KEY=
SMTP2GO_FROM_EMAIL=noreply@shmem.dev
